{
	"extends": "plugin:@wordpress/eslint-plugin/recommended",
	"parserOptions": {
		"requireConfigFile": false,
		"babelOptions": {
			"presets": [ "@wordpress/babel-preset-default" ]
		}
	},
	"overrides": [
		{
			"files": [ "tests/**/*.js" ],
			"rules": {
				"jest/expect-expect": "off"
			}
		}
	]
}
